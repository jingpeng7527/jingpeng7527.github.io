---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <main class="container">
    <h1>404</h1>
    <p>This page doesn't exist. <a href="/">Back to home →</a></p>
  </main>
</Base>

<style>
  main {
    padding: 120px 16px;
  }
  h1 {
    font-family: var(--mono);
    font-size: 48px;
  }
  p {
    color: var(--muted);
  }
</style>
