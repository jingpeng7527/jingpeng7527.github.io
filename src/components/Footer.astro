---
import { profile } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="container">
  <p>© {year} {profile.name} · Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
</footer>

<style>
  footer {
    padding: 32px 16px 48px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted);
  }
  p {
    margin: 0;
  }
</style>
